# Copy to `.env.local` and fill in. NEVER commit the real `.env.local`.

# Optional. Raises the GitHub API rate limit for the build-time repo fetch
# (scripts/fetch-repos.mjs). Without it the fetch still works, just at the
# lower unauthenticated limit of 60 requests/hour.
#
# Fine-grained token with read-only public repo access is sufficient.
# Do NOT grant write or repo scope.
GITHUB_TOKEN=

# Public site URL. Used for canonical tags, sitemap, and OG image URLs.
NEXT_PUBLIC_SITE_URL=https://mfalme.runs-on.dev